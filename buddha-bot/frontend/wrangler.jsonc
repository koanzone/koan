{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buddha-bot",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-28",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "buddha.koanzone.net", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": { "BACKEND_URL": "https://api.koanzone.net", "PUBLIC_SITE": "true" }
}
