{
  "name": "buddha-bot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node tests/protocol.cjs && node --test tests/worker.test.mjs",
    "build:cloudflare": "BUDDHA_CLOUDFLARE_BUILD=1 next build",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "wrangler": "4.142.0"
  },
  "packageManager": "pnpm@11.25.0"
}
